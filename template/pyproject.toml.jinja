[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
authors = [{ name = "{{ author_name }}" }]
license = "MIT"
# Core dependencies: what the package needs to run in ANY context
# (training and serving). Keep this list small: it ends up in the Docker image.
dependencies = [
    "joblib>=1.4",
    "loguru>=0.7",
    "numpy>=2.0",
    "pandas>=2.2",
    "pandera>=0.24",
    "pydantic>=2.8",
    "pydantic-settings>=2.4",
    "pyyaml>=6.0",
    "scikit-learn>=1.5",
]

[project.scripts]
{{ project_slug }} = "{{ package_name }}.pipelines.run:main"

# Dependency groups (PEP 735): installed locally, excluded from the production
# image unless explicitly requested (see Dockerfile).
[dependency-groups]
dev = [
    "httpx2>=2.0",  # used by FastAPI's TestClient
    "poethepoet>=0.29",
    "pre-commit>=4.0",
    "pytest>=8.0",
    "pytest-cov>=5.0",
    "ruff>=0.6",
]
serving = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.30",
]
training = [
    "mlflow>=3.0",
]
notebooks = [
    "ipykernel>=6.29",
    "matplotlib>=3.9",
    "nbstripout>=0.8",
    "seaborn>=0.13",
]
{%- if use_dvc %}
dvc = [
    "dvc>=3.50",
]
{%- endif %}
{%- if use_dbt %}
dbt = [
    "dbt-duckdb>=1.9",
]
{%- endif %}
{%- if use_prefect %}
orchestration = [
    "prefect>=3.0",
]
{%- endif %}
{%- if use_monitoring %}
monitoring = [
    "evidently>=0.7",
    # evidently 0.7.x breaks with pandas 3 (removed internal API); remove this
    # pin once evidently supports pandas 3.
    "pandas<3",
]
{%- endif %}

[tool.uv]
# `uv sync` installs every group locally; the Dockerfile installs only `serving`.
default-groups = [
    "dev",
    "serving",
    "training",
    "notebooks",
{%- if use_dvc %}
    "dvc",
{%- endif %}
{%- if use_dbt %}
    "dbt",
{%- endif %}
{%- if use_prefect %}
    "orchestration",
{%- endif %}
{%- if use_monitoring %}
    "monitoring",
{%- endif %}
]

[build-system]
requires = ["hatchling>=1.25"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
[tool.ruff]
line-length = 88
target-version = "py{{ python_version | replace('.', '') }}"
extend-exclude = ["notebooks"]

[tool.ruff.lint]
# E/F: pycodestyle + pyflakes, I: isort, B: bugbear, UP: pyupgrade,
# SIM: simplifications, N: naming
select = ["E", "F", "I", "B", "UP", "SIM", "N"]
# ML convention: capital `X` for feature matrices is allowed.
ignore = ["N803", "N806"]

[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["tests"]
addopts = "-ra -q --strict-markers --cov={{ package_name }} --cov-report=term-missing --cov-fail-under=85"
markers = [
    "integration: slower tests that exercise several components together",
]
filterwarnings = [
    "ignore::DeprecationWarning",
{%- if use_monitoring %}
    # third-party (evidently) source warning, not our code
    "ignore:invalid escape sequence:SyntaxWarning",
{%- endif %}
]

[tool.coverage.run]
source = ["src/{{ package_name }}"]
omit = ["*/__main__.py"]

# ---------------------------------------------------------------------------
# Task runner (Poe the Poet): the SAME commands run locally and in CI.
# Usage: uv run poe <task>    |   list tasks: uv run poe
# ---------------------------------------------------------------------------
[tool.poe.tasks.lint]
help = "Static checks: ruff lint + format check"
sequence = ["ruff check .", "ruff format --check ."]
default_item_type = "cmd"

[tool.poe.tasks.format]
help = "Auto-format and auto-fix lint issues"
sequence = ["ruff format .", "ruff check --fix ."]
default_item_type = "cmd"

[tool.poe.tasks.test]
help = "Run the test suite with coverage"
cmd = "pytest"

[tool.poe.tasks.check]
help = "Everything CI runs: lint + tests"
sequence = ["lint", "test"]

[tool.poe.tasks.pipeline]
help = "Run the full pipeline: ingest -> validate -> features -> train -> evaluate"
cmd = "python -m {{ package_name }}.pipelines.run --stage all"

[tool.poe.tasks.serve]
help = "Run the prediction API locally with auto-reload"
cmd = "uvicorn {{ package_name }}.serving.app:app --reload --port 8000"

[tool.poe.tasks.mlflow-ui]
help = "Open the MLflow UI (experiments, runs, models)"
cmd = "mlflow ui --backend-store-uri sqlite:///mlflow.db --port 5000"

[tool.poe.tasks.docker-build]
help = "Build the serving image"
cmd = "docker build -t {{ project_slug }}:dev ."

[tool.poe.tasks.docker-run]
help = "Run the serving image (mounts ./models)"
cmd = "docker run --rm -p 8000:8000 -v ./models:/app/models {{ project_slug }}:dev"
{%- if use_dvc %}

[tool.poe.tasks.repro]
help = "Re-run only the pipeline stages whose inputs changed (DVC)"
cmd = "dvc repro"
{%- endif %}
{%- if use_dbt %}

[tool.poe.tasks.dbt-build]
help = "Run dbt models and data tests (DuckDB)"
cmd = "dbt build --project-dir dbt --profiles-dir dbt"
{%- endif %}
{%- if use_prefect %}

[tool.poe.tasks.flow]
help = "Run the pipeline as a Prefect flow"
cmd = "python -m {{ package_name }}.pipelines.flow"
{%- endif %}
{%- if use_compose %}

[tool.poe.tasks.up]
help = "Start API + MLflow server with docker compose"
cmd = "docker compose up --build"
{%- endif %}
{%- if use_monitoring %}

[tool.poe.tasks.drift]
help = "Generate a data drift report (Evidently)"
cmd = "python -m {{ package_name }}.monitoring.drift"
{%- endif %}
