# Local multi-service stack:  uv run poe up
#   API     -> http://localhost:8000/docs
#   MLflow  -> http://localhost:5000
# To log training runs to this server instead of the local sqlite file:
#   APP_MLFLOW_TRACKING_URI=http://localhost:5000 uv run poe pipeline
services:
  api:
    build: .
    image: {{ project_slug }}:dev
    ports:
      - "8000:8000"
    volumes:
      - ./models:/app/models:ro
    depends_on:
      - mlflow

  mlflow:
    image: ghcr.io/mlflow/mlflow:v3.18.0
    command: >
      mlflow server
      --host 0.0.0.0
      --port 5000
      --backend-store-uri sqlite:////mlflow/mlflow.db
      --artifacts-destination /mlflow/artifacts
      --allowed-hosts "*"
    ports:
      - "5000:5000"
    volumes:
      - mlflow-data:/mlflow

volumes:
  mlflow-data:
